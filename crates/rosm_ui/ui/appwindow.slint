import { Button, LineEdit, ScrollView } from "std-widgets.slint";

export struct TagEntry {
    key: string,
    value: string,
}

export struct IssueEntry {
    rule: string,
    message: string,
    severity: string,
}

export component MainWindow inherits Window {
    title: "ROSM - Rust OpenStreetMap Editor";
    min-width: 1024px;
    min-height: 700px;
    background: #18191e;

    // Callbacks to Rust backend
    callback map_pointer_down(float, float, float, float, int);
    callback map_pointer_up(float, float, float, float, int);
    callback map_pointer_move(float, float, float, float);
    callback map_scroll(float, float, float, float, float);
    callback canvas_resized(float, float);

    callback action_open();
    callback action_save();
    callback action_undo();
    callback action_redo();
    callback action_zoom_in();
    callback action_zoom_out();
    callback action_fit_extent();
    callback action_delete();
    callback action_split_way();
    callback action_reverse_way();
    callback action_validate();

    callback set_tool_mode(int); // 0 = Select, 1 = DrawWay
    callback finish_drawing();
    callback cancel_drawing();

    callback add_tag(string, string);
    callback remove_tag(string);
    callback select_issue(int);

    // Properties populated from Rust
    in-out property <image> map_image;
    in-out property <int> active_tool: 0; // 0 = Select, 1 = DrawWay
    in-out property <bool> is_drawing: false;
    in-out property <bool> can_undo: false;
    in-out property <bool> can_redo: false;
    in-out property <bool> is_dirty: false;

    in-out property <bool> has_selection: false;
    in-out property <string> selection_title: "No Selection";
    in-out property <string> selection_details: "";
    in-out property <[TagEntry]> selection_tags: [];

    in-out property <[IssueEntry]> validation_issues: [];
    in-out property <int> issue_count: 0;

    in-out property <string> cursor_coords: "Lat: 0.000000°, Lon: 0.000000°";
    in-out property <string> stats_text: "Nodes: 0 | Ways: 0";
    in-out property <string> status_message: "Ready";

    out property <length> canvas_actual_width: canvas_touch.width;
    out property <length> canvas_actual_height: canvas_touch.height;

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // --- Top Menu & Action Toolbar ---
        Rectangle {
            height: 48px;
            background: #20222a;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 6px;
                padding-bottom: 6px;
                spacing: 8px;

                // Brand
                Text {
                    text: "ROSM";
                    font-size: 16px;
                    font-weight: 700;
                    color: #38bdf8;
                    vertical-alignment: center;
                }

                Rectangle { width: 1px; background: #333846; }

                // File operations
                Button {
                    text: "Open .osm";
                    clicked => { root.action_open(); }
                }

                Button {
                    text: root.is_dirty ? "Save * " : "Save";
                    clicked => { root.action_save(); }
                }

                Rectangle { width: 1px; background: #333846; }

                // History
                Button {
                    text: "Undo";
                    enabled: root.can_undo;
                    clicked => { root.action_undo(); }
                }

                Button {
                    text: "Redo";
                    enabled: root.can_redo;
                    clicked => { root.action_redo(); }
                }

                Rectangle { width: 1px; background: #333846; }

                // Tools
                Button {
                    text: root.active_tool == 0 ? "[Select (S)]" : "Select (S)";
                    clicked => { root.set_tool_mode(0); }
                }

                Button {
                    text: root.active_tool == 1 ? "[Draw Way (D)]" : "Draw Way (D)";
                    clicked => { root.set_tool_mode(1); }
                }

                if root.is_drawing : Button {
                    text: "Finish Way";
                    clicked => { root.finish_drawing(); }
                }

                if root.is_drawing : Button {
                    text: "Cancel";
                    clicked => { root.cancel_drawing(); }
                }

                Rectangle { width: 1px; background: #333846; }

                // Edit Primitives
                Button {
                    text: "Delete";
                    enabled: root.has_selection;
                    clicked => { root.action_delete(); }
                }

                Button {
                    text: "Split Way";
                    enabled: root.has_selection;
                    clicked => { root.action_split_way(); }
                }

                Button {
                    text: "Reverse";
                    enabled: root.has_selection;
                    clicked => { root.action_reverse_way(); }
                }

                Rectangle { width: 1px; background: #333846; }

                // Navigation
                Button {
                    text: "Zoom +";
                    clicked => { root.action_zoom_in(); }
                }

                Button {
                    text: "Zoom -";
                    clicked => { root.action_zoom_out(); }
                }

                Button {
                    text: "Fit Extent";
                    clicked => { root.action_fit_extent(); }
                }

                Rectangle { width: 1px; background: #333846; }

                // Validator
                Button {
                    text: "Validate" + (root.issue_count > 0 ? (" (" + root.issue_count + ")") : "");
                    clicked => { root.action_validate(); }
                }
            }
        }

        // --- Main Workspace: Map Canvas + Sidebar ---
        HorizontalLayout {
            // Left: Map Viewport
            Rectangle {
                horizontal-stretch: 1;
                background: #14151a;
                clip: true;

                init => {
                    root.canvas_resized(self.width / 1px, self.height / 1px);
                }

                Image {
                    width: 100%;
                    height: 100%;
                    source: root.map_image;
                    image-fit: fill;
                }

                canvas_touch := TouchArea {
                    width: 100%;
                    height: 100%;

                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down) {
                            root.map_pointer_down(
                                self.mouse-x / 1px,
                                self.mouse-y / 1px,
                                self.width / 1px,
                                self.height / 1px,
                                event.button == PointerEventButton.left ? 0 : (event.button == PointerEventButton.right ? 1 : 2)
                            );
                        } else if (event.kind == PointerEventKind.up) {
                            root.map_pointer_up(
                                self.mouse-x / 1px,
                                self.mouse-y / 1px,
                                self.width / 1px,
                                self.height / 1px,
                                event.button == PointerEventButton.left ? 0 : (event.button == PointerEventButton.right ? 1 : 2)
                            );
                        }
                    }

                    moved => {
                        root.map_pointer_move(self.mouse-x / 1px, self.mouse-y / 1px, self.width / 1px, self.height / 1px);
                    }

                    scroll-event(event) => {
                        root.map_scroll(self.mouse-x / 1px, self.mouse-y / 1px, self.width / 1px, self.height / 1px, event.delta-y / 1px);
                        return accept;
                    }
                }

                // Drawing banner overlay
                if root.is_drawing : Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: 16px;
                    width: 440px;
                    height: 36px;
                    background: #252836ee;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: #f43f5e;

                    Text {
                        text: "Drawing Way: Click on map to add nodes. Click Finish or Cancel when done.";
                        color: #fecdd3;
                        font-size: 11px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            // Right: Sidebar / Inspector Panel
            Rectangle {
                width: 320px;
                background: #1c1e26;

                VerticalLayout {
                    padding: 12px;
                    spacing: 12px;

                    // Inspector Header
                    VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: "Selection Properties";
                            font-size: 14px;
                            font-weight: 700;
                            color: #f1f5f9;
                        }
                        Text {
                            text: root.selection_title;
                            font-size: 13px;
                            font-weight: 600;
                            color: #facc15;
                        }
                        if root.selection_details != "" : Text {
                            text: root.selection_details;
                            font-size: 11px;
                            color: #94a3b8;
                        }
                    }

                    Rectangle { height: 1px; background: #2e323e; }

                    // Tag Editor Section
                    VerticalLayout {
                        spacing: 6px;
                        Text {
                            text: "Tags";
                            font-size: 12px;
                            font-weight: 600;
                            color: #cbd5e1;
                        }

                        // Tags list
                        ScrollView {
                            height: 160px;
                            VerticalLayout {
                                spacing: 4px;
                                for tag in root.selection_tags : Rectangle {
                                    height: 28px;
                                    background: #242731;
                                    border-radius: 4px;

                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        spacing: 6px;

                                        Text {
                                            text: tag.key;
                                            font-weight: 600;
                                            color: #38bdf8;
                                            vertical-alignment: center;
                                            width: 100px;
                                            overflow: elide;
                                        }

                                        Text {
                                            text: tag.value;
                                            color: #e2e8f0;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                        }

                                        Button {
                                            text: "X";
                                            width: 24px;
                                            clicked => { root.remove_tag(tag.key); }
                                        }
                                    }
                                }
                            }
                        }

                        // Add Tag Row
                        if root.has_selection : HorizontalLayout {
                            spacing: 4px;
                            key_input := LineEdit {
                                placeholder-text: "Key";
                                horizontal-stretch: 1;
                            }
                            val_input := LineEdit {
                                placeholder-text: "Value";
                                horizontal-stretch: 1;
                            }
                            Button {
                                text: "+";
                                width: 32px;
                                clicked => {
                                    if (key_input.text != "" && val_input.text != "") {
                                        root.add_tag(key_input.text, val_input.text);
                                        key_input.text = "";
                                        val_input.text = "";
                                    }
                                }
                            }
                        }
                    }

                    Rectangle { height: 1px; background: #2e323e; }

                    // Validation Section
                    VerticalLayout {
                        vertical-stretch: 1;
                        spacing: 6px;

                        HorizontalLayout {
                            Text {
                                text: "Validator Issues";
                                font-size: 12px;
                                font-weight: 600;
                                color: #cbd5e1;
                                vertical-alignment: center;
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Text {
                                text: root.issue_count + " issues";
                                font-size: 11px;
                                color: root.issue_count > 0 ? #f43f5e : #34d399;
                                vertical-alignment: center;
                            }
                        }

                        ScrollView {
                            VerticalLayout {
                                spacing: 4px;
                                for issue[idx] in root.validation_issues : Rectangle {
                                    height: 48px;
                                    background: #242731;
                                    border-radius: 4px;
                                    border-width: 1px;
                                    border-color: issue.severity == "Error" ? #f43f5e : #fbbf24;

                                    TouchArea {
                                        clicked => { root.select_issue(idx); }

                                        VerticalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            padding-top: 4px;
                                            padding-bottom: 4px;
                                            spacing: 2px;

                                            Text {
                                                text: issue.rule;
                                                font-size: 11px;
                                                font-weight: 700;
                                                color: #f1f5f9;
                                            }
                                            Text {
                                                text: issue.message;
                                                font-size: 10px;
                                                color: #94a3b8;
                                                overflow: elide;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // --- Bottom Status Bar ---
        Rectangle {
            height: 26px;
            background: #181920;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 16px;

                Text {
                    text: root.status_message;
                    font-size: 11px;
                    color: #94a3b8;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }

                Text {
                    text: root.stats_text;
                    font-size: 11px;
                    color: #cbd5e1;
                    vertical-alignment: center;
                }

                Text {
                    text: root.cursor_coords;
                    font-size: 11px;
                    color: #cbd5e1;
                    vertical-alignment: center;
                }
            }
        }
    }
}
